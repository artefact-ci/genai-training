# Copy this file to `.env` at the repository root, then fill in the values.
# `.env` is git-ignored: never commit real credentials.

# Model provider. Only azure_openai is implemented for now; the labs go through
# commun/llm so that adding a provider does not touch the exercises.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI -----------------------------------------------------------
# Endpoint of your Azure OpenAI resource, e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names, as created in the Azure portal. These are deployment names,
# not model names: they are whatever your organisation called them.
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Needed from chapter 3 onwards (RAG).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
